{
  "name": "viraj-neural-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Viraj Choudhary's reference-locked neural portfolio.",
  "scripts": {
    "asset:original": "node scripts/select-neural-asset.mjs original",
    "asset:public": "node scripts/select-neural-asset.mjs public",
    "dev": "npm run asset:original && cross-env NEXT_PUBLIC_NEURAL_PROFILE=original next dev",
    "dev:public": "npm run asset:public && cross-env NEXT_PUBLIC_NEURAL_PROFILE=public next dev",
    "build": "npm run asset:original && cross-env NEXT_PUBLIC_NEURAL_PROFILE=original next build",
    "build:public": "npm run asset:public && cross-env NEXT_PUBLIC_NEURAL_PROFILE=public next build && node scripts/assert-public-build.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "motion": "12.42.2",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "cross-env": "10.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
